import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TrackRow } from "models.slint";
export { TrackRow }

import { InteractiveProgressBar } from "components/progress_bar.slint";
import { InteractiveVolumeBar } from "components/volume_bar.slint";
import { LoadingSpinner } from "components/loading_spinner.slint";
import { TrackItemView } from "views/track_item.slint";


export component AppWindow inherits Window {
    title: "YouTube Audio Player";
    preferred-width: 540px;
    preferred-height: root.queue_expanded ? 360px : 130px;
    min-width: 500px;
    min-height: root.queue_expanded ? 310px : 130px;
    max-height: root.queue_expanded ? 100000px : 130px;
    background: #1F1D1B;
    default-font-family: "Segoe UI, sans-serif";

    // --- State Properties (Decoupled Visual State) ---
    in-out property <string> track_title: "Ready to Play";
    in-out property <string> track_artist: "Enter a search query, playlist, or YouTube URL";
    in-out property <string> time_display: "00:00 / 00:00";
    in-out property <string> track_status: "READY";
    in-out property <string> track_badge: "AAC";
    in-out property <bool> is_playing: false;
    in-out property <bool> is_loading: false;
    in-out property <image> cover_image;
    in-out property <bool> has_cover: false;

    // Visual Progress: Normalized 0.0 to 1.0 (Timer purely updates this)
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> buffer_ratio: 0.0;
    in-out property <bool> is_scrubbing: false;
    in-out property <bool> has_active_track: false;

    // Visual Volume: Normalized 0.0 to 1.0
    in-out property <float> volume_ratio: 1.0;
    in-out property <bool> is_muted: false;
    in-out property <bool> queue_expanded: false;
    in-out property <string> panel_tab: "QUEUE";
    in-out property <string> panel_message: "";
    in-out property <[TrackRow]> search_results: [];
    in-out property <[TrackRow]> queue_items: [];
    in-out property <[TrackRow]> favorite_items: [];
    in-out property <[TrackRow]> history_items: [];
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> repeat_mode_label: "REPEAT OFF";
    in-out property <bool> can_retry: false;
    in-out property <string> current_track_key: "";
    in-out property <bool> current_is_favorite: false;

    // --- Callbacks (User Intent Only, Never triggered by Timer) ---
    callback search_and_play(string);
    callback cancel_loading();
    callback select_panel_tab(string);
    callback play_search_result(string);
    callback enqueue_search_result(string);
    callback toggle_search_favorite(string);
    callback play_queue_item(int);
    callback remove_queue_item(int);
    callback move_queue_item_up(int);
    callback move_queue_item_down(int);
    callback clear_queue();
    callback play_favorite(string);
    callback remove_favorite(string);
    callback play_history(string);
    callback favorite_history(string);
    callback cycle_repeat_mode();
    callback toggle_shuffle();
    callback retry_playback();
    callback toggle_current_favorite();
    callback toggle_play_pause();
    callback play_previous();
    callback play_next();
    callback stop();
    callback on_user_scrub(float);
    callback on_user_seek(float);
    callback on_user_volume(float);
    callback toggle_mute();
    callback toggle_queue();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #1F1D1B;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 130px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 10px;

            // ================= 1. LEFT: COVER ART =================
            Rectangle {
                width: 90px;
                height: 90px;
                background: #2B2825;
                border-radius: 6px;
                border-width: 1px;
                border-color: #4E4740;
                clip: true;

                if root.has_cover: Image {
                    source: root.cover_image;
                    image-fit: cover;
                    width: 100%;
                    height: 100%;
                }

                // Default Cover: Musical Note Vector
                if !root.has_cover: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #262321;

                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        fill: #7FA09B;
                        commands: "M 10 34 A 5 4 0 1 1 15 30 L 15 10 L 33 6 L 33 26 A 5 4 0 1 1 38 22 L 38 3 L 12 7 L 12 30 A 5 4 0 0 1 10 34 Z";
                    }
                }
            }

            // ================= 2. CENTER: INFO & PROGRESS =================
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 5px;
                alignment: space-between;

                // --- Top Search Bar ---
                HorizontalLayout {
                    spacing: 6px;

                    search_input := LineEdit {
                        placeholder-text: "Search song, playlist, or paste YouTube link...";
                        font-size: 11px;
                        horizontal-stretch: 1;
                        accepted => {
                            if (self.text != "") {
                                root.search_and_play(self.text);
                            }
                        }
                    }

                    // Search Button
                    search_btn := Rectangle {
                        width: 30px;
                        height: 30px;
                        background: search_touch.has-hover ? #8EAEA9 : #7FA09B;
                        border-radius: 4px;
                        animate background { duration: 100ms; }

                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            stroke: #1F1D1B;
                            stroke-width: 2px;
                            commands: "M 6.5 2 A 4.5 4.5 0 1 0 11 6.5 A 4.5 4.5 0 0 0 6.5 2 Z M 10 10 L 14.5 14.5";
                        }

                        search_touch := TouchArea {
                            enabled: !root.is_loading && search_input.text != "";
                            mouse-cursor: pointer;
                            clicked => {
                                if (search_input.text != "") {
                                    root.search_and_play(search_input.text);
                                }
                            }
                        }
                    }

                    queue_btn := Rectangle {
                        width: 32px;
                        height: 30px;
                        background: queue_touch.has-hover ? #383430 : #2B2825;
                        border-width: 1px;
                        border-color: root.queue_expanded ? #7FA09B : #4E4740;
                        border-radius: 4px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            padding-left: 8px;
                            padding-right: 8px;

                            Rectangle {
                                width: 14px;
                                height: 2px;
                                background: root.queue_expanded ? #7FA09B : #E4DDD5;
                                border-radius: 1px;
                            }
                            Rectangle {
                                width: 14px;
                                height: 2px;
                                background: root.queue_expanded ? #7FA09B : #E4DDD5;
                                border-radius: 1px;
                            }
                            Rectangle {
                                width: 14px;
                                height: 2px;
                                background: root.queue_expanded ? #7FA09B : #E4DDD5;
                                border-radius: 1px;
                            }
                        }

                        queue_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_queue(); }
                        }
                    }
                }

                // --- Track Metadata Row ---
                VerticalLayout {
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: root.track_title;
                            font-size: 13px;
                            font-weight: 700;
                            color: #E4DDD5;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        // Codec / Format Badge
                        Rectangle {
                            background: #2B2825;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #4E4740;

                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                padding-top: 1px;
                                padding-bottom: 1px;

                                Text {
                                    text: root.track_badge;
                                    font-size: 9px;
                                    font-weight: 600;
                                    color: #7FA09B;
                                }
                            }
                        }

                        if root.current_track_key != "": Rectangle {
                            width: 22px;
                            height: 22px;
                            background: favorite_touch.has-hover ? #3D3833 : #2B2825;
                            border-radius: 3px;
                            Text {
                                text: root.current_is_favorite ? "♥" : "♡";
                                color: root.current_is_favorite ? #C9B087 : #A39A8E;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            favorite_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle_current_favorite(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: root.track_artist;
                            font-size: 11px;
                            color: #A39A8E;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if root.is_loading: LoadingSpinner {
                            loading: root.is_loading;
                        }

                        Text {
                            text: root.track_status;
                            font-size: 10px;
                            font-weight: 600;
                            color: root.track_status == "ERROR" ? #D18D78 : (root.is_loading || root.track_status == "BUFFERING" || root.track_status == "SEARCHING" ? #C9B087 : (root.is_playing ? #7FA09B : #5E564F));
                        }

                        if root.is_loading: Rectangle {
                            width: 20px;
                            height: 18px;
                            background: cancel_touch.has-hover ? #E09E8A : #D18D78;
                            border-radius: 3px;
                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                stroke: #1F1D1B;
                                stroke-width: 1.8px;
                                commands: "M 2 2 L 8 8 M 8 2 L 2 8";
                            }
                            cancel_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.cancel_loading(); }
                            }
                        }

                        if root.can_retry: Rectangle {
                            width: 20px;
                            height: 18px;
                            background: retry_touch.has-hover ? #8EAEA9 : #7FA09B;
                            border-radius: 3px;
                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                stroke: #1F1D1B;
                                stroke-width: 1.5px;
                                commands: "M 8.5 5 A 3.5 3.5 0 1 1 7.5 2.5 L 9.5 2.5 M 9.5 2.5 L 9.5 4.5";
                            }
                            retry_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.retry_playback(); }
                            }
                        }
                    }
                }

                // --- Decoupled Interactive Progress Bar ---
                HorizontalLayout {
                    spacing: 6px;

                    InteractiveProgressBar {
                        horizontal-stretch: 1;
                        ratio <=> root.progress_ratio;
                        buffer_ratio <=> root.buffer_ratio;
                        is_scrubbing <=> root.is_scrubbing;
                        enabled: root.has_active_track;
                        user_scrub(r) => {
                            root.on_user_scrub(r);
                        }
                        user_seek(r) => {
                            root.on_user_seek(r);
                        }
                    }

                    Text {
                        text: root.time_display;
                        font-size: 10px;
                        color: #A39A8E;
                        min-width: 72px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            // ================= 3. RIGHT: EQUAL-SIZE ACTION BUTTONS & VOLUME =================
            VerticalLayout {
                width: 155px;
                spacing: 6px;
                alignment: space-between;

                // --- Playback Controls: Prev, Play/Pause, Next, Stop ---
                HorizontalLayout {
                    spacing: 5px;
                    alignment: center;

                    // Previous Button
                    prev_btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        background: prev_touch.has-hover ? #383430 : #2B2825;
                        border-width: 1px;
                        border-color: #4E4740;
                        border-radius: 4px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding-top: 8px;
                            padding-bottom: 8px;

                            Rectangle {
                                width: 2px;
                                height: 10px;
                                background: #E4DDD5;
                                border-radius: 1px;
                            }

                            Path {
                                width: 8px;
                                height: 10px;
                                fill: #E4DDD5;
                                commands: "M 8 0 L 0 5 L 8 10 Z";
                            }
                        }

                        prev_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.play_previous();
                            }
                        }
                    }

                    // Play / Pause Button (Prominent 38x38 button)
                    play_btn := Rectangle {
                        width: 38px;
                        height: 38px;
                        background: play_touch.has-hover ? #8EAEA9 : #7FA09B;
                        border-radius: 6px;
                        animate background { duration: 100ms; }

                        if !root.is_playing: Path {
                            x: (parent.width - self.width) / 2 + 1px;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            fill: #1F1D1B;
                            commands: "M 2 1 L 15 8 L 2 15 Z";
                        }

                        if root.is_playing: HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            padding-top: 11px;
                            padding-bottom: 11px;

                            Rectangle {
                                width: 4px;
                                height: 16px;
                                background: #1F1D1B;
                                border-radius: 1px;
                            }
                            Rectangle {
                                width: 4px;
                                height: 16px;
                                background: #1F1D1B;
                                border-radius: 1px;
                            }
                        }

                        play_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.toggle_play_pause();
                            }
                        }
                    }

                    // Next Button
                    next_btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        background: next_touch.has-hover ? #383430 : #2B2825;
                        border-width: 1px;
                        border-color: #4E4740;
                        border-radius: 4px;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding-top: 8px;
                            padding-bottom: 8px;

                            Path {
                                width: 8px;
                                height: 10px;
                                fill: #E4DDD5;
                                commands: "M 0 0 L 8 5 L 0 10 Z";
                            }

                            Rectangle {
                                width: 2px;
                                height: 10px;
                                background: #E4DDD5;
                                border-radius: 1px;
                            }
                        }

                        next_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.play_next();
                            }
                        }
                    }

                    // Stop Button
                    stop_btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        background: stop_touch.has-hover ? #383430 : #2B2825;
                        border-width: 1px;
                        border-color: #4E4740;
                        border-radius: 4px;
                        animate background { duration: 100ms; }

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 10px;
                            height: 10px;
                            background: #E4DDD5;
                            border-radius: 2px;
                        }

                        stop_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.stop();
                            }
                        }
                    }
                }

                // Volume row: Clean, non-collapsing layout within 145px
                HorizontalLayout {
                    spacing: 5px;
                    alignment: center;

                    Rectangle {
                        width: 24px;
                        height: 20px;
                        background: mute_touch.has-hover ? #383430 : #2B2825;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.is_muted ? #C9B087 : #4E4740;

                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            fill: root.is_muted ? #C9B087 : #A39A8E;
                            commands: "M 1 4 L 3.5 4 L 7 1.5 L 7 10.5 L 3.5 8 L 1 8 Z";
                        }

                        if !root.is_muted && root.volume_ratio > 0.05: Path {
                            x: (parent.width - self.width) / 2 + 3px;
                            y: (parent.height - self.height) / 2;
                            width: 6px;
                            height: 12px;
                            stroke: #A39A8E;
                            stroke-width: 1.2px;
                            commands: "M 1 4.5 A 2.5 2.5 0 0 1 1 7.5";
                        }

                        if root.is_muted: Path {
                            x: (parent.width - self.width) / 2 + 3px;
                            y: (parent.height - self.height) / 2;
                            width: 6px;
                            height: 12px;
                            stroke: #C9B087;
                            stroke-width: 1.5px;
                            commands: "M 0 3.5 L 5 8.5 M 5 3.5 L 0 8.5";
                        }

                        mute_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_mute(); }
                        }
                    }

                    InteractiveVolumeBar {
                        horizontal-stretch: 1;
                        volume <=> root.volume_ratio;
                        user_volume(v) => {
                            root.on_user_volume(v);
                        }
                    }

                    Text {
                        text: Math.round(root.volume_ratio * 100.0) + "%";
                        font-size: 10px;
                        color: #A39A8E;
                        min-width: 28px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.queue_expanded: Rectangle {
            x: 0px;
            y: 130px;
            width: 100%;
            height: parent.height - 130px;
            background: #262321;

            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 4px;

                HorizontalLayout {
                    height: 26px;
                    spacing: 4px;

                    for tab[index] in ["SEARCH", "QUEUE", "SAVED", "HISTORY"]: Rectangle {
                        width: 58px;
                        height: 24px;
                        background: root.panel_tab == tab ? #7FA09B : #2B2825;
                        border-radius: 3px;

                        Text {
                            text: tab;
                            color: root.panel_tab == tab ? #1F1D1B : #E4DDD5;
                            font-size: 9px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select_panel_tab(tab); }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: #2B2825;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.repeat_mode_label != "REPEAT OFF" ? #7FA09B : transparent;

                        // Loop arrows icon
                        Path {
                            x: (parent.width - self.width) / 2 - (root.repeat_mode_label == "REPEAT ONE" ? 2px : 0px);
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 12px;
                            stroke: root.repeat_mode_label != "REPEAT OFF" ? #7FA09B : #A39A8E;
                            stroke-width: 1.4px;
                            commands: "M 3 4 L 11 4 A 2.5 2.5 0 0 1 13.5 6.5 L 13.5 6.5 L 11.5 8.5 M 11 8 L 3 8 A 2.5 2.5 0 0 1 0.5 5.5 L 0.5 5.5 L 2.5 3.5";
                        }

                        if root.repeat_mode_label == "REPEAT ONE": Text {
                            x: 17px;
                            y: 3px;
                            text: "1";
                            color: #7FA09B;
                            font-size: 8px;
                            font-weight: 800;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cycle_repeat_mode(); }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 24px;
                        background: root.shuffle_enabled ? #3D3833 : #2B2825;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.shuffle_enabled ? #7FA09B : transparent;

                        // Crossing arrows shuffle icon
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 12px;
                            stroke: root.shuffle_enabled ? #7FA09B : #A39A8E;
                            stroke-width: 1.4px;
                            commands: "M 1 2.5 L 5 2.5 L 9 9.5 L 13 9.5 M 10.5 7.5 L 13 9.5 L 10.5 11.5 M 1 9.5 L 5 9.5 L 6.5 6.8 M 7.5 5.2 L 9 2.5 L 13 2.5 M 10.5 0.5 L 13 2.5 L 10.5 4.5";
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_shuffle(); }
                        }
                    }

                    if root.panel_tab == "QUEUE" && root.queue_items.length > 0: Rectangle {
                        width: 28px;
                        height: 24px;
                        background: #3D3833;
                        border-radius: 3px;

                        // Trash can / Clear icon
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            stroke: #D18D78;
                            stroke-width: 1.3px;
                            commands: "M 2 3 L 10 3 M 4.5 3 L 4.5 1.5 L 7.5 1.5 L 7.5 3 M 3 3 L 3.5 11 L 8.5 11 L 9 3";
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clear_queue(); }
                        }
                    }
                }

                Text {
                    text: root.panel_message;
                    color: #C9B087;
                    font-size: 9px;
                    height: root.panel_message == "" ? 0px : 14px;
                    overflow: elide;
                }

                if root.panel_tab == "SEARCH" && root.search_results.length > 0: ListView {
                    height: 130px;
                    vertical-stretch: 1;
                    for item[index] in root.search_results: TrackItemView {
                        item: item;
                        index: index;
                        mode: "SEARCH";
                        play => { root.play_search_result(item.key); }
                        enqueue => { root.enqueue_search_result(item.key); }
                        toggle_fav => { root.toggle_search_favorite(item.key); }
                    }
                }

                if root.panel_tab == "SEARCH" && root.search_results.length == 0: Text {
                    text: "Search for a song or paste a YouTube link.";
                    color: #A39A8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }

                if root.panel_tab == "QUEUE" && root.queue_items.length > 0: ListView {
                    height: 130px;
                    vertical-stretch: 1;
                    for item[index] in root.queue_items: TrackItemView {
                        item: item;
                        index: index;
                        mode: "QUEUE";
                        play => { root.play_queue_item(index); }
                        remove => { root.remove_queue_item(index); }
                    }
                }

                if root.panel_tab == "QUEUE" && root.queue_items.length == 0: Text {
                    text: "Queue is empty · add songs from Search.";
                    color: #A39A8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }

                if root.panel_tab == "SAVED" && root.favorite_items.length > 0: ListView {
                    height: 130px;
                    vertical-stretch: 1;
                    for item[index] in root.favorite_items: TrackItemView {
                        item: item;
                        index: index;
                        mode: "SAVED";
                        play => { root.play_favorite(item.key); }
                        remove => { root.remove_favorite(item.key); }
                    }
                }

                if root.panel_tab == "SAVED" && root.favorite_items.length == 0: Text {
                    text: "No favorites saved yet.";
                    color: #A39A8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }

                if root.panel_tab == "HISTORY" && root.history_items.length > 0: ListView {
                    height: 130px;
                    vertical-stretch: 1;
                    for item[index] in root.history_items: TrackItemView {
                        item: item;
                        index: index;
                        mode: "HISTORY";
                        play => { root.play_history(item.key); }
                        toggle_fav => { root.favorite_history(item.key); }
                    }
                }

                if root.panel_tab == "HISTORY" && root.history_items.length == 0: Text {
                    text: "No recently played tracks yet.";
                    color: #A39A8E;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
            }
        }
    }
}
