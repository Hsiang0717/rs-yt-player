import { Theme, TooltipState } from "theme.slint";
import { TrackRow } from "models.slint";
export { TrackRow }

import { TitleBarView } from "views/title_bar.slint";
import { PlayerDeckView } from "views/player_deck.slint";
import { PlaylistDrawerView } from "views/playlist_drawer.slint";

export component AppWindow inherits Window {
    title: "YouTube Audio Player";
    icon: @image-url("../yt_audio_icon.ico");
    no-frame: true;
    preferred-width: 580px;
    preferred-height: root.queue_expanded ? 460px : 185px;
    min-width: 520px;
    min-height: 185px;
    max-height: 100000px;
    background: Theme.bg;
    default-font-family: "Segoe UI, sans-serif";
    forward-focus: key_scope;

    // --- State Properties (Decoupled Visual State) ---
    in-out property <string> track_title: "Ready to Play";
    in-out property <string> track_artist: "Enter a search query, playlist, or YouTube URL";
    in-out property <string> time_display: "00:00 / 00:00";
    in-out property <string> time_current: "00:00";
    in-out property <string> time_total: "00:00";
    in-out property <string> track_status: "READY";
    in-out property <string> track_badge: "AAC";
    in-out property <bool> is_playing: false;
    in-out property <bool> is_loading: false;
    in-out property <image> cover_image;
    in-out property <bool> has_cover: false;

    // Visual Progress: Normalized 0.0 to 1.0
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> buffer_ratio: 0.0;
    in-out property <bool> is_scrubbing: false;
    in-out property <bool> has_active_track: false;

    // Visual Volume & Modes
    in-out property <float> volume_ratio: 1.0;
    in-out property <bool> is_muted: false;
    in-out property <bool> queue_expanded: false;
    in-out property <bool> pinned_on_top: false;
    always-on-top: root.pinned_on_top;
    in-out property <bool> autoplay_enabled: true;
    in-out property <string> sleep_timer_label: "";
    in-out property <string> panel_tab: "QUEUE";
    in-out property <string> panel_message: "";
    in-out property <[TrackRow]> search_results: [];
    in-out property <[TrackRow]> queue_items: [];
    in-out property <[TrackRow]> favorite_items: [];
    in-out property <[TrackRow]> history_items: [];
    in-out property <bool> shuffle_enabled: false;
    in-out property <string> repeat_mode_label: "REPEAT OFF";
    in-out property <bool> can_retry: false;
    in-out property <string> current_track_key: "";
    in-out property <bool> current_is_favorite: false;
    in-out property <string> search_query: "";

    // --- Callbacks (Window Management) ---
    callback start_window_drag();
    callback toggle_always_on_top();
    callback minimize_window();
    callback close_window();

    // --- Callbacks (User Intent Only) ---
    callback search_and_play(string);
    callback cancel_loading();
    callback select_panel_tab(string);
    callback play_search_result(string);
    callback enqueue_search_result(string);
    callback play_next_in_queue(string);
    callback play_all(string);
    callback enqueue_all(string);
    callback toggle_search_favorite(string);
    callback play_queue_item(int);
    callback remove_queue_item(int);
    callback move_queue_item_up(int);
    callback move_queue_item_down(int);
    callback clear_queue();
    callback play_favorite(string);
    callback remove_favorite(string);
    callback play_history(string);
    callback favorite_history(string);
    callback cycle_repeat_mode();
    callback toggle_shuffle();
    callback toggle_autoplay();
    callback cycle_sleep_timer();
    callback retry_playback();
    callback toggle_current_favorite();
    callback toggle_play_pause();
    callback play_previous();
    callback play_next();
    callback stop();
    callback on_user_scrub(float);
    callback on_user_seek(float);
    callback seek_relative(float);
    callback on_user_volume(float);
    callback toggle_mute();
    callback toggle_queue();

    // Global Keyboard Shortcuts Scope (Active when search input is not focused)
    key_scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (title_bar.has_search_focus()) {
                return reject;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "l" || event.text == "L")) {
                title_bar.focus_search();
                return accept;
            }
            if (event.text == "/") {
                title_bar.focus_search();
                return accept;
            }
            if (event.text == " ") {
                root.toggle_play_pause();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.control) {
                    root.play_previous();
                } else {
                    root.seek_relative(-5.0);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.control) {
                    root.play_next();
                } else {
                    root.seek_relative(5.0);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.on_user_volume(Math.min(1.0, root.volume_ratio + 0.05));
                root.volume_ratio = Math.min(1.0, root.volume_ratio + 0.05);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.on_user_volume(Math.max(0.0, root.volume_ratio - 0.05));
                root.volume_ratio = Math.max(0.0, root.volume_ratio - 0.05);
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.toggle_mute();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            title_bar := TitleBarView {
                search_query <=> root.search_query;
                always_on_top: root.pinned_on_top;
                start_window_drag => { root.start_window_drag(); }
                search_accepted(q) => {
                    root.panel_tab = "SEARCH";
                    root.queue_expanded = true;
                    root.search_and_play(q);
                }
                toggle_always_on_top => { root.toggle_always_on_top(); }
                minimize_window => { root.minimize_window(); }
                close_window => { root.close_window(); }
                focus_returned => { key_scope.focus(); }
            }

            PlayerDeckView {
                track_title: root.track_title;
                track_artist: root.track_artist;
                time_current: root.time_current;
                time_total: root.time_total;
                track_status: root.track_status;
                track_badge: root.track_badge;
                is_playing: root.is_playing;
                is_loading: root.is_loading;
                cover_image: root.cover_image;
                has_cover: root.has_cover;
                progress_ratio <=> root.progress_ratio;
                buffer_ratio <=> root.buffer_ratio;
                is_scrubbing <=> root.is_scrubbing;
                has_active_track: root.has_active_track;
                volume_ratio <=> root.volume_ratio;
                is_muted: root.is_muted;
                queue_expanded: root.queue_expanded;
                shuffle_enabled: root.shuffle_enabled;
                repeat_mode_label: root.repeat_mode_label;
                autoplay_enabled: root.autoplay_enabled;
                sleep_timer_label: root.sleep_timer_label;
                can_retry: root.can_retry;
                current_track_key: root.current_track_key;
                current_is_favorite: root.current_is_favorite;

                background_clicked => { title_bar.clear_search_focus(); }
                cancel_loading => { root.cancel_loading(); }
                retry_playback => { root.retry_playback(); }
                toggle_current_favorite => { root.toggle_current_favorite(); }
                toggle_autoplay => { root.toggle_autoplay(); }
                cycle_sleep_timer => { root.cycle_sleep_timer(); }
                on_user_scrub(r) => { root.on_user_scrub(r); }
                on_user_seek(r) => { root.on_user_seek(r); }
                toggle_shuffle => { root.toggle_shuffle(); }
                play_previous => { root.play_previous(); }
                toggle_play_pause => { root.toggle_play_pause(); }
                play_next => { root.play_next(); }
                cycle_repeat_mode => { root.cycle_repeat_mode(); }
                toggle_mute => { root.toggle_mute(); }
                on_user_volume(v) => { root.on_user_volume(v); }
                toggle_queue => { root.toggle_queue(); }
            }

            if root.queue_expanded: PlaylistDrawerView {
                panel_tab: root.panel_tab;
                panel_message: root.panel_message;
                search_results: root.search_results;
                queue_items: root.queue_items;
                favorite_items: root.favorite_items;
                history_items: root.history_items;

                background_clicked => { title_bar.clear_search_focus(); }
                select_panel_tab(tab) => { root.select_panel_tab(tab); }
                clear_queue => { root.clear_queue(); }
                play_all(tab) => { root.play_all(tab); }
                enqueue_all(tab) => { root.enqueue_all(tab); }

                play_search_result(k) => { root.play_search_result(k); }
                play_next_track(k) => { root.play_next_in_queue(k); }
                enqueue_track(k) => { root.enqueue_search_result(k); }
                toggle_search_favorite(k) => { root.toggle_search_favorite(k); }

                play_queue_item(i) => { root.play_queue_item(i); }
                remove_queue_item(i) => { root.remove_queue_item(i); }
                move_queue_item_up(i) => { root.move_queue_item_up(i); }
                move_queue_item_down(i) => { root.move_queue_item_down(i); }

                play_favorite(k) => { root.play_favorite(k); }
                remove_favorite(k) => { root.remove_favorite(k); }

                play_history(k) => { root.play_history(k); }
                favorite_history(k) => { root.favorite_history(k); }
            }
        }

        // Non-clipped Floating Tooltip Pill
        if TooltipState.text != "": Rectangle {
            x: 12px;
            y: 44px;
            z: 999;
            height: 20px;
            width: tooltip_txt.preferred-width + 14px;
            border-radius: 4px;
            background: Theme.surface_active;
            border-width: 1px;
            border-color: Theme.accent_primary;

            tooltip_txt := Text {
                text: TooltipState.text;
                font-size: 10px;
                color: Theme.text_primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}