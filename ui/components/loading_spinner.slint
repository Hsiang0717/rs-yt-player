import { Theme } from "../theme.slint";

export component LoadingSpinner {
    in property <bool> loading: false;
    width: 14px;
    height: 14px;

    property <float> pulse: 0.0;

    animate pulse {
        duration: 900ms;
        iteration-count: -1;
        easing: ease-in-out;
    }

    states [
        active when root.loading: {
            pulse: 1.0;
        }
        inactive when !root.loading: {
            pulse: 0.0;
        }
    ]

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 7px;
        border-width: 2px;
        border-color: Theme.accent_gold;
        opacity: 0.3 + 0.7 * root.pulse;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 6px + 4px * root.pulse;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent_gold;
        opacity: 0.5 + 0.5 * root.pulse;
    }
}
