import { Theme } from "../theme.slint";

export component InteractiveVolumeBar {
    in-out property <float> volume: 1.0;
    callback user_volume(float);

    height: 20px;
    min-width: 60px;

    track := Rectangle {
        width: 100%;
        y: (parent.height - self.height) / 2;
        height: 4px;
        background: Theme.surface_hover;
        border-radius: 2px;

        fill := Rectangle {
            x: 0;
            y: 0;
            width: parent.width * Math.max(0.0, Math.min(1.0, root.volume));
            height: parent.height;
            background: Theme.accent_primary;
            border-radius: 2px;
        }

        thumb := Rectangle {
            x: Math.max(0px, Math.min(parent.width - self.width, parent.width * Math.max(0.0, Math.min(1.0, root.volume)) - (self.width / 2)));
            y: (parent.height - self.height) / 2;
            width: touch.has-hover ? 12px : 8px;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.text_primary;
            animate width { duration: 80ms; }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        moved => {
            if (self.pressed) {
                let clamped = Math.max(0.0, Math.min(1.0, self.mouse-x / self.width));
                root.volume = clamped;
                root.user_volume(clamped);
            }
        }

        clicked => {
            let clamped = Math.max(0.0, Math.min(1.0, self.mouse-x / self.width));
            root.volume = clamped;
            root.user_volume(clamped);
        }
    }
}
