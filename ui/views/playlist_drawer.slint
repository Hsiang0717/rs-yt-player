import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TrackRow } from "../models.slint";
import { IconButton } from "../components/icon_button.slint";
import { TrackItemView } from "track_item.slint";

export component PlaylistDrawerView inherits Rectangle {
    in property <string> panel_tab: "PLAYLIST";
    in property <string> panel_message: "";
    in property <bool> is_loading: false;
    in property <int> current_queue_index: -1;
    in property <[TrackRow]> search_results: [];
    in property <[TrackRow]> queue_items: [];
    in property <[TrackRow]> favorite_items: [];

    in-out property <length> playlist_scroll_y: 0px;

    public function scroll_to_current() {
        if root.current_queue_index >= 0 {
            root.playlist_scroll_y = - Math.max(0px, root.current_queue_index * 44px - Math.max(0px, (root.height - 48px - 44px) / 2));
        }
    }

    init => {
        if root.panel_tab == "PLAYLIST" {
            root.scroll_to_current();
        }
    }

    changed current_queue_index => {
        if root.panel_tab == "PLAYLIST" {
            root.scroll_to_current();
        }
    }

    changed panel_tab => {
        if root.panel_tab == "PLAYLIST" {
            root.scroll_to_current();
        }
    }

    callback background_clicked();
    callback select_panel_tab(string);
    callback clear_queue();
    callback enqueue_all(string);

    callback play_search_result(string);
    callback play_next_track(string);
    callback enqueue_track(string);
    callback toggle_search_favorite(string);

    callback play_queue_item(int);
    callback remove_queue_item(int);
    callback move_queue_item_up(int);
    callback move_queue_item_down(int);

    callback play_favorite(string);
    callback remove_favorite(string);

    vertical-stretch: 1;
    background: Theme.panel_bg;
    clip: true;

    TouchArea {
        clicked => { root.background_clicked(); }
    }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        // Capsule Navigation Tabs + Batch Action Buttons
        HorizontalLayout {
            height: 28px;
            spacing: 6px;
            alignment: start;

            for tab[index] in ["SEARCH", "PLAYLIST", "SAVED"]: Rectangle {
                width: 76px;
                height: 26px;
                border-radius: 6px;
                background: root.panel_tab == tab ? Theme.accent_primary : (tab_touch.has-hover ? Theme.surface_hover : Theme.surface);
                animate background { duration: 120ms; }

                Text {
                    text: tab;
                    color: root.panel_tab == tab ? Theme.text_dark : Theme.text_primary;
                    font-size: 10.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                tab_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.select_panel_tab(tab);
                        if tab == "PLAYLIST" {
                            root.scroll_to_current();
                        }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Locate Current Track Button
            if root.panel_tab == "PLAYLIST" && root.current_queue_index >= 0 && root.queue_items.length > 0: IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("../icons/locate.svg");
                icon_size: 14px;
                default_color: Theme.accent_primary;
                hover_color: Theme.accent_primary_hover;
                clicked => { root.scroll_to_current(); }
            }

            // Add All to Playlist Icon Button (for SEARCH / SAVED)
            if (root.panel_tab == "SEARCH" && root.search_results.length > 0) ||
               (root.panel_tab == "SAVED" && root.favorite_items.length > 0): IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("../icons/playlist-plus.svg");
                icon_size: 15px;
                default_color: Theme.accent_primary;
                hover_color: Theme.accent_primary_hover;
                clicked => { root.enqueue_all(root.panel_tab); }
            }

            // Clear Playlist Button
            if root.panel_tab == "PLAYLIST" && root.queue_items.length > 0: IconButton {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("../icons/trash.svg");
                icon_size: 14px;
                default_color: Theme.accent_danger;
                hover_color: #E09E8A;
                clicked => { root.clear_queue(); }
            }
        }

        if root.panel_message != "": Text {
            text: root.panel_message;
            color: Theme.accent_gold;
            font-size: 10px;
            height: 14px;
            overflow: elide;
        }

        // --- Search Results ---
        if root.panel_tab == "SEARCH" && root.search_results.length > 0: ListView {
            vertical-stretch: 1;
            for item[index] in root.search_results: TrackItemView {
                item: item;
                index: index;
                total_count: root.search_results.length;
                is_loading: root.is_loading;
                mode: "SEARCH";
                play => { root.play_search_result(item.key); }
                play_next => { root.play_next_track(item.key); }
                enqueue => { root.enqueue_track(item.key); }
                toggle_fav => { root.toggle_search_favorite(item.key); }
            }
        }

        if root.panel_tab == "SEARCH" && root.search_results.length == 0: Text {
            text: "Search for a song or paste a YouTube link.";
            color: Theme.text_secondary;
            font-size: 11.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        // --- Playlist ---
        if root.panel_tab == "PLAYLIST" && root.queue_items.length > 0: playlist_list := ListView {
            vertical-stretch: 1;
            content-y <=> root.playlist_scroll_y;
            animate content-y { duration: 250ms; easing: ease-out; }
            for item[index] in root.queue_items: TrackItemView {
                item: item;
                index: index;
                total_count: root.queue_items.length;
                is_loading: root.is_loading;
                mode: "PLAYLIST";
                play => { root.play_queue_item(index); }
                remove => { root.remove_queue_item(index); }
                toggle_fav => { root.toggle_search_favorite(item.key); }
                move_up => { root.move_queue_item_up(index); }
                move_down => { root.move_queue_item_down(index); }
            }
        }

        if root.panel_tab == "PLAYLIST" && root.queue_items.length == 0: Text {
            text: "Playlist is empty · add songs from Search or Saved.";
            color: Theme.text_secondary;
            font-size: 11.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        // --- Favorites (Saved) ---
        if root.panel_tab == "SAVED" && root.favorite_items.length > 0: ListView {
            vertical-stretch: 1;
            for item[index] in root.favorite_items: TrackItemView {
                item: item;
                index: index;
                total_count: root.favorite_items.length;
                is_loading: root.is_loading;
                mode: "SAVED";
                play => { root.play_favorite(item.key); }
                play_next => { root.play_next_track(item.key); }
                enqueue => { root.enqueue_track(item.key); }
                remove => { root.remove_favorite(item.key); }
            }
        }

        if root.panel_tab == "SAVED" && root.favorite_items.length == 0: Text {
            text: "No favorites saved yet.";
            color: Theme.text_secondary;
            font-size: 11.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
    }
}