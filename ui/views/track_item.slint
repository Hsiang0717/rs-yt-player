import { Theme } from "../theme.slint";
import { TrackRow } from "../models.slint";
import { IconButton } from "../components/icon_button.slint";

export component TrackItemView inherits Rectangle {
    in property <TrackRow> item;
    in property <int> index: 0;
    in property <int> total_count: 1;
    in property <string> mode: "SEARCH"; // "SEARCH", "QUEUE", "SAVED", "HISTORY"

    callback play();
    callback play_next();
    callback enqueue();
    callback toggle_fav();
    callback remove();
    callback move_up();
    callback move_down();

    height: 44px;
    background: root.item.is_current ? Theme.surface_active : (item_touch.has-hover ? Theme.surface_hover : (Math.mod(root.index, 2) == 0 ? Theme.surface : Theme.surface_alt));
    border-radius: 6px;
    border-width: 1px;
    border-color: root.item.is_current ? Theme.border : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;

        // 1. 左側當前播放指示豎條 (固定位置)
        Rectangle {
            width: 3px;
            height: 22px;
            background: root.item.is_current ? Theme.accent_primary : transparent;
            border-radius: 1.5px;
            y: (parent.height - self.height) / 2;
        }

        // 2. 歌曲點擊播放區塊 (靠左固定縮圖 + 伸縮歌名)
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 10px;

                // 固定 34x34 縮圖與佔位圖 (永遠置左)
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 4px;
                    clip: true;
                    background: Theme.panel_bg;
                    y: (parent.height - self.height) / 2;

                    Image {
                        source: @image-url("../icons/music-note.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text_muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    Image {
                        source: root.item.cover;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }
                }

                // 歌名與作者 (填滿剩餘寬度，靠左對齊)
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.item.title;
                        color: root.item.is_current ? Theme.accent_primary : Theme.text_primary;
                        font-size: 12px;
                        font-weight: root.item.is_current ? 700 : 500;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: root.item.artist;
                        color: Theme.text_secondary;
                        font-size: 10px;
                        overflow: elide;
                        horizontal-alignment: left;
                    }
                }
            }

            item_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
        }

        // 3. 右側固定時長 (支援 HH:MM:SS 長音訊格式不溢位)
        Text {
            text: root.item.duration;
            color: Theme.text_muted;
            font-size: 11px;
            vertical-alignment: center;
            min-width: 52px;
            horizontal-alignment: right;
        }

        // 4. 右側操作按鈕區
        if root.mode == "SEARCH": HorizontalLayout {
            spacing: 4px;
            alignment: center;

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/play-next.svg");
                icon_size: 13px;
                default_color: Theme.text_secondary;
                hover_color: Theme.accent_primary;
                tooltip: "Play Next";
                clicked => { root.play_next(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/plus.svg");
                icon_size: 13px;
                default_color: Theme.accent_primary;
                hover_color: Theme.accent_primary_hover;
                tooltip: "Add to Queue";
                clicked => { root.enqueue(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: root.item.is_favorite ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                icon_size: 13px;
                active: root.item.is_favorite;
                active_color: Theme.accent_gold;
                default_color: Theme.text_secondary;
                tooltip: root.item.is_favorite ? "Remove Favorite" : "Save to Favorites";
                clicked => { root.toggle_fav(); }
            }
        }

        if root.mode == "HISTORY": HorizontalLayout {
            spacing: 4px;
            alignment: center;

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/play-next.svg");
                icon_size: 13px;
                default_color: Theme.text_secondary;
                hover_color: Theme.accent_primary;
                tooltip: "Play Next";
                clicked => { root.play_next(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/plus.svg");
                icon_size: 13px;
                default_color: Theme.accent_primary;
                hover_color: Theme.accent_primary_hover;
                tooltip: "Add to Queue";
                clicked => { root.enqueue(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: root.item.is_favorite ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                icon_size: 13px;
                active: root.item.is_favorite;
                active_color: Theme.accent_gold;
                default_color: Theme.text_secondary;
                tooltip: root.item.is_favorite ? "Remove Favorite" : "Save to Favorites";
                clicked => { root.toggle_fav(); }
            }
        }

        if root.mode == "SAVED": HorizontalLayout {
            spacing: 4px;
            alignment: center;

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/play-next.svg");
                icon_size: 13px;
                default_color: Theme.text_secondary;
                hover_color: Theme.accent_primary;
                tooltip: "Play Next";
                clicked => { root.play_next(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/plus.svg");
                icon_size: 13px;
                default_color: Theme.accent_primary;
                hover_color: Theme.accent_primary_hover;
                tooltip: "Add to Queue";
                clicked => { root.enqueue(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/close.svg");
                icon_size: 13px;
                default_color: Theme.accent_gold;
                hover_color: Theme.accent_gold_hover;
                tooltip: "Remove from Saved";
                clicked => { root.remove(); }
            }
        }

        if root.mode == "QUEUE": HorizontalLayout {
            spacing: 2px;
            alignment: center;

            IconButton {
                width: 22px;
                height: 24px;
                icon: @image-url("../icons/chevron-up.svg");
                icon_size: 13px;
                enabled: root.index > 0;
                default_color: Theme.text_secondary;
                hover_color: Theme.accent_primary;
                tooltip: "Move Up";
                clicked => { root.move_up(); }
            }

            IconButton {
                width: 22px;
                height: 24px;
                icon: @image-url("../icons/chevron-down.svg");
                icon_size: 13px;
                enabled: root.index + 1 < root.total_count;
                default_color: Theme.text_secondary;
                hover_color: Theme.accent_primary;
                tooltip: "Move Down";
                clicked => { root.move_down(); }
            }

            IconButton {
                width: 24px;
                height: 24px;
                icon: @image-url("../icons/close.svg");
                icon_size: 13px;
                default_color: Theme.accent_danger;
                hover_color: #E09E8A;
                tooltip: "Remove from Queue";
                clicked => { root.remove(); }
            }
        }
    }
}